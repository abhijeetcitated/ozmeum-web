# Copy to .env.local (local dev) and add the same keys in Cloudflare Pages > Settings > Environment variables
# Free key from https://web3forms.com — claim requests get emailed to you. Leave empty to use the mailto fallback.
VITE_WEB3FORMS_KEY=
# Where claim requests / mailto fallback should go
VITE_CONTACT_EMAIL=hello@ozmeum.com
